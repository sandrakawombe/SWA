  <diagram name="Page-1" id="xcuh593JqR7kbIHgTolv">
    <mxGraphModel dx="4680" dy="1847" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection TB\n\n%% ======================= SERVICE LAYER =======================\nclass ProductCatalogService\nclass SupplierService\nclass ShoppingService {\n    +checkoutCart()\n}\nclass OrderService {\n    +createOrder(ShoppingCart cart)\n    +setShippingAddress()\n    +setBillingAddress()\n    +setPayment()\n}\nclass CustomerService {\n    +getLoggedOnCustomer()\n}\n\n%% ======================= DOMAIN LAYER =======================\nclass Product {\n    &lt;&lt;entity&gt;&gt;\n    +productNumber\n    +description\n    +price\n}\nclass Review {\n    &lt;&lt;value object&gt;&gt;\n    +title\n    +description\n    +score\n}\nclass Stock {\n    &lt;&lt;value object&gt;&gt;\n    +nrInStock\n    +locationCode\n}\nclass Supplier {\n    &lt;&lt;value object&gt;&gt;\n    +supplierNumber\n    +name\n    +phone\n    +email\n}\nclass Shoppingcart {\n    &lt;&lt;entity&gt;&gt;\n    +shoppingcartNumber\n    +addToCart()\n    +removeFromCart()\n    +changeQuantity()\n    +checkout()\n}\nclass CartLine {\n    &lt;&lt;value object&gt;&gt;\n    +quantity\n}\nclass Order {\n    &lt;&lt;entity&gt;&gt;\n    +orderNumber\n    +date\n    +status\n    +confirm()\n}\nclass OrderLine {\n    &lt;&lt;value object&gt;&gt;\n    +quantity\n}\nclass ShippingOption {\n    &lt;&lt;value object&gt;&gt;\n    +name\n    +price\n    +shipper\n}\nclass CreditCard {\n    &lt;&lt;value object&gt;&gt;\n    +number\n    +validationdate\n}\nclass Address {\n    &lt;&lt;value object&gt;&gt;\n    +street\n    +city\n    +zip\n    +country\n}\nclass Customer {\n    &lt;&lt;entity&gt;&gt;\n    +customerNumber\n    +firstName\n    +lastName\n    +email\n    +phone\n}\nclass Account {\n    &lt;&lt;value object&gt;&gt;\n    +accountNumber\n    +username\n    +password\n}\n\n%% ======================= DATA ACCESS LAYER =======================\nclass ProductDAO\nclass SupplierDAO\nclass ShoppingCartDAO\nclass OrderDAO\nclass CustomerDAO\n\n%% ======================= INTEGRATION LAYER =======================\nclass EmailSender {\n    +send()\n}\n\n%% ======================= SERVICE -&gt; DOMAIN / DAO =======================\nProductCatalogService ..&gt; Product\nProductCatalogService ..&gt; ProductDAO\nSupplierService ..&gt; Supplier\nSupplierService ..&gt; SupplierDAO\nShoppingService ..&gt; Shoppingcart\nShoppingService ..&gt; ShoppingCartDAO\nOrderService ..&gt; Order\nOrderService ..&gt; OrderDAO\nOrderService ..&gt; EmailSender\nCustomerService ..&gt; Customer\nCustomerService ..&gt; CustomerDAO\n\n%% ======================= DOMAIN RELATIONSHIPS =======================\nProduct \&quot;1\&quot; --&gt; \&quot;*\&quot; Review\nProduct \&quot;1\&quot; --&gt; \&quot;1\&quot; Stock\nProduct \&quot;1\&quot; --&gt; \&quot;1\&quot; Supplier\nSupplier \&quot;1\&quot; --&gt; \&quot;1\&quot; Address\n\nShoppingcart \&quot;1\&quot; --&gt; \&quot;*\&quot; CartLine\nCartLine \&quot;1\&quot; --&gt; \&quot;1\&quot; Product\n\nOrder \&quot;1\&quot; --&gt; \&quot;*\&quot; OrderLine\nOrderLine \&quot;1\&quot; --&gt; \&quot;1\&quot; Product\nOrder \&quot;1\&quot; --&gt; \&quot;1\&quot; Address : billing\nOrder \&quot;1\&quot; --&gt; \&quot;1\&quot; Address : shipping\nOrder \&quot;1\&quot; --&gt; \&quot;1\&quot; CreditCard\nOrder \&quot;1\&quot; --&gt; \&quot;1\&quot; ShippingOption\nOrder \&quot;*\&quot; --&gt; \&quot;1\&quot; Customer\n\nCustomer \&quot;1\&quot; --&gt; \&quot;1\&quot; Account\nCustomer \&quot;1\&quot; --&gt; \&quot;1\&quot; Address\nCustomer \&quot;1\&quot; --&gt; \&quot;*\&quot; CreditCard\n\n%% ======================= DAO -&gt; DOMAIN =======================\nProductDAO ..&gt; Product\nSupplierDAO ..&gt; Supplier\nShoppingCartDAO ..&gt; Shoppingcart\nOrderDAO ..&gt; Order\nCustomerDAO ..&gt; Customer&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6DHydFY2_BIDKEn-Muga-1">
